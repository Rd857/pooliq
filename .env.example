# PoolIQ environment variables
#
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed. All variable names must keep
# the REACT_APP_ prefix — Create React App only exposes env vars to the
# browser bundle when they're prefixed this way.
#
# Restart `npm start` after changing any of these — CRA only reads
# process.env.REACT_APP_* at build/dev-server start time.

# --- Firebase (project: pooliq-f401b) ---------------------------------
# Get these from Firebase Console -> Project settings -> General ->
# "Your apps" -> Web app -> SDK setup and configuration.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# --- Weather (Cloudflare Worker proxy for Ambient Weather) ------------
# URL of the deployed pooliq-weather Worker (see workers/pooliq-weather/).
# Example: https://pooliq-weather.<your-subdomain>.workers.dev
REACT_APP_WEATHER_WORKER_URL=
